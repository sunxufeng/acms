# ---- Feishu 应用（DEV 环境）----
FEISHU_APP_ID=cli_aa03bcd61eb8dce3
FEISHU_APP_SECRET=
FEISHU_BASE_TOKEN=RIAgbQsrfa7EJdslDnkcdAuanyd
# OAuth 回调地址（API 可公网访问时填公网域名）
FEISHU_REDIRECT_URI=https://acms-dev.areteailab.com/api/v1/auth/callback

# ---- 会话 ----
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=3600
SESSION_COOKIE=acms_sid

# ---- 登录限流（60s 固定窗口）----
AUTH_IP_RATE_LIMIT=10
AUTH_GLOBAL_RATE_LIMIT=120

# ---- 引导管理员（首个登录自动建档为系统管理员，逗号分隔；上线后建议清空）----
BOOTSTRAP_ADMIN_OPEN_IDS=

# ---- DEV 便捷开关：开启后任何完成飞书 OAuth 的 DEV 用户自动建档为普通内部账号 ----
# 取值 1 / true / dev 时生效；留空则在用户表非空且未登记时拒绝登录（NOT_REGISTERED）。
# prod 不设此变量即可维持原行为。自注册默认角色/密级可用 SELF_REGISTER_ROLE / SELF_REGISTER_LEVEL 覆盖。
ALLOW_SELF_REGISTER=
SELF_REGISTER_ROLE=教师本人
SELF_REGISTER_LEVEL=内部

# ---- 服务 ----
API_PORT=3000
WEB_ORIGIN=http://localhost:3100

# ---- 微信小程序（学生端 / P0 登录绑定）----
# 在微信公众平台「开发管理 → 开发设置」获取；留空则后端返回 WECHAT_NOT_CONFIGURED，
# 小程序登录会提示未配置（本地可用 devCode 联调）。
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=

# ---- 邮件自动归档：账户密码 AES-256-GCM 加密密钥 ----
# 任意长度字符串（服务端用 scrypt 派生为 32 字节密钥）。部署时若缺失会自动生成并写入 .env。
MAIL_CRED_KEY=
