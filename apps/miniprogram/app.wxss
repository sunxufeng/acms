page {
  background: #f5f6fa;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
  color: #1f2330;
}

.container {
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(31, 35, 48, 0.06);
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #8a90a2;
  margin-bottom: 24rpx;
}

.btn {
  background: #4f46e5;
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  text-align: center;
  margin-top: 24rpx;
}

.btn-ghost {
  background: #eef0fb;
  color: #4f46e5;
}

.input {
  background: #f5f6fa;
  border-radius: 14rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f1f5;
  font-size: 28rpx;
}

.row .k {
  color: #8a90a2;
}

.row .v {
  color: #1f2330;
  font-weight: 500;
  max-width: 60%;
  text-align: right;
}

.status-big {
  font-size: 56rpx;
  font-weight: 800;
  text-align: center;
  margin: 20rpx 0;
}

.status-pass {
  color: #18a058;
}

.status-fail {
  color: #e54848;
}

.muted {
  color: #8a90a2;
  font-size: 24rpx;
}

.tabs {
  display: flex;
  background: #fff;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 16rpx 0;
  border-radius: 999rpx;
  color: #8a90a2;
}

.tab.active {
  background: #4f46e5;
  color: #fff;
}
