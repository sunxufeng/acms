[Unit]
Description=ACMS Web slot %i (Blue-Green)
After=network.target

[Service]
Type=simple
# 与旧版 acms-web.service 保持一致以 ecs-user 运行（.env 为 0600，owner 即 ecs-user，可正常读取）
User=ecs-user
WorkingDirectory=/opt/acms/repo/apps/web
# 凭证与环境变量统一从 /opt/acms/.env 读取（含 WEB_ORIGIN 等）
EnvironmentFile=/opt/acms/.env
# 平滑部署关键：web 必须走对外 https 域名访问 API。
# ⚠️ 历史坑：曾写 http://127.0.0.1，但 nginx :80 无条件 return 301 https，
#   导致 SSR fetch(${API_ORIGIN}/api/v1/homepage-config) 走 127.0.0.1:80 → 301 →
#   https://127.0.0.1 TLS(SNI 不匹配)失败 → catch 回退默认配置 → 登录页/全站品牌主题丢失。
# 今改为 https://acms.areteailab.com：该域名证书有效、解析到本机、随 slot 切换自动跟随
#   nginx upstream，且 200 直连无需 TLS 握手到错误 SNI。
# Environment 在 EnvironmentFile 之后，覆盖 /opt/acms/.env 中可能写死的 API_ORIGIN。
Environment=API_ORIGIN=https://acms.areteailab.com
# ⚠️ 注意：systemd 的 %i specifier 在 Environment= 中【不展开】，必须用 ExecStart 内联传目录/端口。
# 用 bash -c 内联 NEXT_DIST_DIR=.next-%i（展开为实例目录，如 .next-3101）与 -p %i（实例端口，如 3101）；
# exec 让 next 取代 bash 进程，保证 systemd 信号直达。
ExecStart=/bin/bash -c 'NEXT_DIST_DIR=.next-%i exec /opt/acms/repo/apps/web/node_modules/.bin/next start -p %i'
Restart=on-failure
RestartSec=5
TimeoutStartSec=90
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=acms-web-%i

[Install]
WantedBy=multi-user.target
