<view class="container">
  <view class="tabs">
    <view class="tab {{tab==='profile'?'active':''}}" data-tab="profile" bindtap="switchTab">档案</view>
    <view class="tab {{tab==='schedule'?'active':''}}" data-tab="schedule" bindtap="switchTab">周课表</view>
    <view class="tab {{tab==='grades'?'active':''}}" data-tab="grades" bindtap="switchTab">成绩</view>
    <view class="tab {{tab==='teachers'?'active':''}}" data-tab="teachers" bindtap="switchTab">授课教师</view>
  </view>

  <view wx:if="{{errMsg}}" class="card"><view class="muted" style="color:#e54848;">{{errMsg}}</view></view>
  <view wx:if="{{loading}}" class="card"><view class="muted" style="text-align:center;">加载中…</view></view>

  <block wx:if="{{!loading && !errMsg}}">
    <!-- 档案 -->
    <view wx:if="{{tab==='profile'}}" class="card">
      <view wx:for="{{profileRows}}" wx:key="k" class="row">
        <text class="k">{{item.k}}</text>
        <text class="v">{{item.v}}</text>
      </view>
    </view>

    <!-- 周课表 -->
    <view wx:if="{{tab==='schedule'}}" class="card">
      <view wx:for="{{schedule}}" wx:key="课次" class="row" style="flex-direction:column;align-items:flex-start;">
        <text style="font-weight:600;">{{item.课次}}</text>
        <text class="muted">{{item.日期}} {{item.时间}} · {{item.教学班}} · {{item.教师}} · {{item.场地}} · {{item.状态}}</text>
      </view>
      <view wx:if="{{schedule.length===0}}" class="muted" style="text-align:center;">暂无课表</view>
    </view>

    <!-- 成绩 -->
    <view wx:if="{{tab==='grades'}}" class="card">
      <view wx:for="{{grades}}" wx:key="学科" class="row" style="flex-direction:column;align-items:flex-start;">
        <text style="font-weight:600;">{{item.学科}} · {{item.成绩}}（{{item.等级}}）</text>
        <text class="muted">{{item.学期}} · {{item.类型}} · {{item.教师}}{{item.评语!=='—' ? ' · '+item.评语 : ''}}</text>
      </view>
      <view wx:if="{{grades.length===0}}" class="muted" style="text-align:center;">暂无成绩</view>
    </view>

    <!-- 授课教师 -->
    <view wx:if="{{tab==='teachers'}}" class="card">
      <view wx:for="{{teachers}}" wx:key="姓名" style="padding:18rpx 0;border-bottom:1rpx solid #f0f1f5;">
        <view style="font-weight:700;font-size:32rpx;">{{item.姓名}}</view>
        <view class="muted">{{item.meta}}</view>
        <view class="muted" style="margin-top:6rpx;">{{item.简介}}</view>
      </view>
      <view wx:if="{{teachers.length===0}}" class="muted" style="text-align:center;">暂无授课教师</view>
    </view>
  </block>
</view>
