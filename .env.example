# ---- Feishu 应用 ----
FEISHU_APP_ID=cli_aa0a476b9038dce3
FEISHU_APP_SECRET=
FEISHU_BASE_TOKEN=VhlPbR5tEa2ACjsugq0cRBSvnlf
# OAuth 回调地址（API 可公网访问时填公网域名）
FEISHU_REDIRECT_URI=https://acms.areteailab.com/api/v1/auth/callback

# ---- 会话 ----
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=3600
SESSION_COOKIE=acms_sid

# ---- 登录限流（60s 固定窗口）----
AUTH_IP_RATE_LIMIT=10
AUTH_GLOBAL_RATE_LIMIT=120

# ---- 引导管理员（首个登录自动建档为系统管理员，逗号分隔；上线后建议清空）----
BOOTSTRAP_ADMIN_OPEN_IDS=

# ---- 服务 ----
API_PORT=3000
WEB_ORIGIN=http://localhost:3100

# ---- 微信小程序（学生端 / P0 登录绑定）----
# 在微信公众平台「开发管理 → 开发设置」获取；留空则后端返回 WECHAT_NOT_CONFIGURED，
# 小程序登录会提示未配置（本地可用 devCode 联调）。
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
